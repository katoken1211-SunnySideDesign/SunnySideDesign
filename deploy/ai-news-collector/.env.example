# Copy to a local .env only when preparing deployment; do not commit real values.
# NAS host path, NOT the path seen inside codex-agent. items/runs/scheduler must already exist.
AI_NEWS_INBOX_DIR=/REPLACE_WITH_NAS_PATH/Development/ai-news-inbox
# Both IDs must be numeric and non-zero. Startup rejects UID 0, GID 0 and root supplementary groups.
# Find the intended NAS service account's UID/GID; do not assume 1000. Run the UGOS preflight before deployment.
AI_NEWS_UID=REPLACE_WITH_UID
AI_NEWS_GID=REPLACE_WITH_GID
